{
  "manifest_version": 3,
  "name": "GLaDOS Auto Check-in",
  "version": "3.2.3",
  "description": "GLaDOS 每日自动签到 — 多域名自动切换，Cookie 认证，超时重试，随机签到，无需打开页面",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://glados.cloud/*",
    "https://glados.space/*",
    "https://railgun.info/*",
    "https://glados.one/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "manifest_version": 3,
  "name": "GLaDOS Auto Check-in",
  "version": "3.0.0",
  "description": "GLaDOS 每日自动签到 — 双保险方案 (cookies + DNR)，智能随机签到，开机补签，无需打开页面",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://glados.one/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
